generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COLLABORATOR
  VIEWER
}

enum PortionStatus {
  NA
  OPEN
  PARTIALLY_PAID
  PAID
}

enum OverallStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

enum PaymentMode {
  CASH
  UPI
  CHEQUE
  BANK_TRANSFER
  OTHER
}

enum BillPortion {
  GOLD
  DIAMOND
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(VIEWER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bills        Bill[]     @relation("BillCreatedBy")
  payments     Payment[]  @relation("PaymentCreatedBy")
  auditLogs    AuditLog[]
}

model Group {
  id            String    @id @default(uuid()) @db.Uuid
  category      String
  subCategory   String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customers     Customer[]

  @@unique([category, subCategory])
  @@index([category])
}

model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  phone             String
  address           String?
  goldCreditDays    Int
  diamondCreditDays Int
  advanceAmount     Decimal   @default(0) @db.Decimal(12, 2)
  creditBalance     Decimal   @default(0) @db.Decimal(12, 2)
  notes             String?
  groupId           String?   @db.Uuid
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  group             Group?    @relation(fields: [groupId], references: [id])
  bills             Bill[]
  payments          Payment[]

  @@index([name])
  @@index([phone])
  @@index([groupId])
}

model Bill {
  id                String              @id @default(uuid()) @db.Uuid
  billNumber        String              @unique
  customerId        String              @db.Uuid
  billDate          DateTime            @db.Date
  description       String?
  goldAmount        Decimal             @default(0) @db.Decimal(12, 2)
  diamondAmount     Decimal             @default(0) @db.Decimal(12, 2)
  goldDueDate       DateTime?           @db.Date
  diamondDueDate    DateTime?           @db.Date
  goldAmountPaid    Decimal             @default(0) @db.Decimal(12, 2)
  diamondAmountPaid Decimal             @default(0) @db.Decimal(12, 2)
  goldStatus        PortionStatus       @default(NA)
  diamondStatus     PortionStatus       @default(NA)
  overallStatus     OverallStatus       @default(OPEN)
  createdByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  customer          Customer            @relation(fields: [customerId], references: [id])
  createdBy         User                @relation("BillCreatedBy", fields: [createdByUserId], references: [id])
  allocations       PaymentAllocation[]

  @@index([customerId, overallStatus])
  @@index([billDate])
}

model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  customerId        String              @db.Uuid
  paymentDate       DateTime            @db.Date
  amount            Decimal             @db.Decimal(12, 2)
  unallocatedAmount Decimal             @default(0) @db.Decimal(12, 2)
  mode              PaymentMode?
  notes             String?
  createdByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  customer          Customer            @relation(fields: [customerId], references: [id])
  createdBy         User                @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  allocations       PaymentAllocation[]

  @@index([customerId, paymentDate])
}

model PaymentAllocation {
  id                       String      @id @default(uuid()) @db.Uuid
  paymentId                String      @db.Uuid
  billId                   String      @db.Uuid
  portion                  BillPortion
  amountAllocated          Decimal     @db.Decimal(12, 2)
  daysOverdueAtAllocation  Int
  wasTieBreak              Boolean     @default(false)
  createdAt                DateTime    @default(now())

  payment                  Payment     @relation(fields: [paymentId], references: [id])
  bill                     Bill        @relation(fields: [billId], references: [id])

  @@index([paymentId])
  @@index([billId, portion])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  metadata   Json
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
